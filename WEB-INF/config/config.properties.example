DEV.GwtpaxAi5.AgentMemoryTtlMin=30
# AI 상담5 작동 과정 시연 페이지 (/gwtpax/ai5-flow.do). 내부 규칙·도구 값을 그대로 보여 주므로 발표 때만 Y
DEV.GwtpaxAi5.FlowEnabled=Y
# 병원 홈페이지 자료 검색 (Weaviate, app-api RAG 와 같은 문서). 키는 직접 넣을 것 (가능하면 읽기 전용 키)
DEV.GwtpaxAi5.WeaviateUrl=http://192.168.0.153:26026
DEV.GwtpaxAi5.WeaviateApiKey=REPLACE_WITH_LOCAL_VALUE
DEV.GwtpaxAi5.WeaviateTenant=gwtpax
# 문서 검색 hybrid + 리랭크 (dinohelper 의 Infinity 서버, 2026-10-23). EmbedUrl 을 비우면 키워드(BM25)만, RerankUrl 을 비우면 리랭크 안 함
# EmbedApiKey 는 llm 서버 dinohelper .env 의 EMBED_API_KEY 를 직접 넣을 것
DEV.GwtpaxAi5.EmbedUrl=http://192.168.0.153:26021
DEV.GwtpaxAi5.EmbedApiKey=REPLACE_WITH_LOCAL_VALUE
DEV.GwtpaxAi5.RerankUrl=http://192.168.0.153:26022
# 0=키워드만, 1=벡터만 (2026-10-23 비교로 0.5)
DEV.GwtpaxAi5.DocsAlpha=0.5
# 건강정보 출처 링크 (사용 안 함: 포털 상세는 POST 로만 열리고 주소로 들어가면 메인으로 돌아감, 2026-10-15 확인)
#DEV.GwtpaxAi5.HealthSourceUrl=https://health.kdca.go.kr/healthinfo/biz/health/gnrlzHealthInfo/gnrlzHealthInfo/gnrlzHealthInfoView.do?cntntsSn={id}
# 음성 입력 (CLOVA Speech 단문 인식 REST, 2026-10-22). 녹음을 끝낸 뒤 한 번에 인식 (60초 이내)
# 키는 CLOVA Speech "단문 인식" 도메인의 secret key. 키가 비어 있으면 마이크 버튼이 나오지 않는다
DEV.GwtpaxAi5.SttEnabled=Y
DEV.GwtpaxAi5.ClovaSpeechSecretKey=REPLACE_WITH_LOCAL_VALUE
# 단문 인식 invoke url. 비우면 https://clovaspeech-gw.ncloud.com/recog/v1/stt (도메인 주소만 넣으면 /recog/v1/stt 를 붙인다)
DEV.GwtpaxAi5.ClovaSpeechInvokeUrl=https://clovaspeech-gw.ncloud.com/recog/v1/stt
# 녹음 최대 초 (5~60, CLOVA 단문 한도 60초. 30초를 넘기면 nginx client_max_body_size 1MB 기본값에 걸릴 수 있음), 동시 인식 수 (1~20)
DEV.GwtpaxAi5.SttMaxSec=20
DEV.GwtpaxAi5.SttMaxConcurrent=3

