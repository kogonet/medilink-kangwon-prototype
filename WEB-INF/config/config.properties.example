DEV.GwtpaxAi4.AgentModel=gemma4:e4b-it-q4_K_M
DEV.GwtpaxAi4.AgentMaxSteps=4
DEV.GwtpaxAi4.AgentTemperature=0.2
DEV.GwtpaxAi4.AgentLlmTimeoutMs=30000
DEV.GwtpaxAi4.AgentTotalTimeoutMs=60000
DEV.GwtpaxAi4.AgentMaxConcurrent=2
DEV.GwtpaxAi4.AgentMemoryTurns=3
DEV.GwtpaxAi4.AgentMemoryTtlMin=30
# AI 상담4 작동 과정 시연 페이지 (/gwtpax/ai4-flow.do). 내부 규칙·도구 값을 그대로 보여 주므로 발표 때만 Y
DEV.GwtpaxAi4.FlowEnabled=Y
# 병원 홈페이지 자료 검색 (Weaviate, app-api RAG 와 같은 문서). 키는 직접 넣을 것 (가능하면 읽기 전용 키)
DEV.GwtpaxAi4.WeaviateUrl=http://192.168.0.153:26026
DEV.GwtpaxAi4.WeaviateApiKey=REPLACE_WITH_LOCAL_VALUE
DEV.GwtpaxAi4.WeaviateTenant=gwtpax
# 건강정보 출처 링크 (사용 안 함: 포털 상세는 POST 로만 열리고 주소로 들어가면 메인으로 돌아감, 2026-10-15 확인)
#DEV.GwtpaxAi4.HealthSourceUrl=https://health.kdca.go.kr/healthinfo/biz/health/gnrlzHealthInfo/gnrlzHealthInfo/gnrlzHealthInfoView.do?cntntsSn={id}

