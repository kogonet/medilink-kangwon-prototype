      <span class="pill">
        <svg viewBox="0 0 16 16" width="13" height="13" fill="none" stroke="var(--green)" stroke-width="2" stroke-linecap="round"><path d="M8 2l1.5 4h4l-3.5 2.5L11.5 13 8 10.5 4.5 13l1.5-4.5L2 6h4z"/></svg>
