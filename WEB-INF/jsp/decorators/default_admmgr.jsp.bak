								if( !"".equals(menuNm4) ){
								out.println(menuNm4);
								}else{
									if( !"".equals(menuNm3) ){
										out.println(menuNm3);
									}else{
										if( !"".equals(menuNm2) ){
											out.println(menuNm2);
										}else{
											out.println(menuNm1);
										}
									}
								}
							}

							%>
