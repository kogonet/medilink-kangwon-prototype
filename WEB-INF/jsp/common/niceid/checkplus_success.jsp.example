<%@page import="com.ctit.helper.Cvt"%>
<%@page import="java.util.Map"%>
<%@page import="com.ctit.helper.IDao"%>
<%@page import="com.ctit.base.CBase"%>
<%@page import="com.ctit.helper.CDao"%>
<%@ page contentType="text/html;charset=utf-8" %>

<%
	//인증 후 결과값이 null로 나오는 부분은 관리담당자에게 문의 바랍니다.
    NiceID.Check.CPClient niceCheck = new  NiceID.Check.CPClient();

    String sEncodeData = requestReplace(request.getParameter("EncodeData"), "encodeData");
    
    String sSiteCode = "CF570";					// NICE로부터 부여받은 사이트 코드
    String sSitePassword = "REPLACE_WITH_LOCAL_CREDENTIAL";		// NICE로부터 부여받은 사이트 패스워드

    String sCipherTime = "";			// 복호화한 시간
    String sRequestNumber = "";			// 요청 번호
    String sResponseNumber = "";		// 인증 고유번호
    String sAuthType = "";				// 인증 수단
    String sName = "";					// 성명
    String sDupInfo = "";				// 중복가입 확인값 (DI_64 byte)
    String sConnInfo = "";				// 연계정보 확인값 (CI_88 byte)
    String sBirthDate = "";				// 생년월일(YYYYMMDD)
    String sGender = "";				// 성별
    String sNationalInfo = "";			// 내/외국인정보 (개발가이드 참조)
	String sMobileNo = "";				// 휴대폰번호
	String sMobileCo = "";				// 통신사
    String sMessage = "";
    String sPlainData = "";
    String sUserId = "";
  	String sType = "";      			//회원가입(join) or 아이디/비밀번호 찾기(find)
  	String userTp = "";
  	
  	String pwSearchId = "";
    
    int iReturn = niceCheck.fnDecode(sSiteCode, sSitePassword, sEncodeData);
  	
    if( iReturn == 0 )
    {
        sPlainData = niceCheck.getPlainData();
        sCipherTime = niceCheck.getCipherDateTime();
        
        // 데이타를 추출합니다.
        java.util.HashMap mapresult = niceCheck.fnParse(sPlainData);
        
        sRequestNumber  = (String)mapresult.get("REQ_SEQ");
        sResponseNumber = (String)mapresult.get("RES_SEQ");
        sAuthType		= (String)mapresult.get("AUTH_TYPE");
        sName			= (String)mapresult.get("NAME");
		//sName			= (String)mapresult.get("UTF8_NAME"); //charset utf8 사용시 주석 해제 후 사용
        sBirthDate		= (String)mapresult.get("BIRTHDATE");
        sGender			= (String)mapresult.get("GENDER");
        sNationalInfo  	= (String)mapresult.get("NATIONALINFO");
        sDupInfo		= (String)mapresult.get("DI");
        sConnInfo		= (String)mapresult.get("CI");
        sMobileNo		= (String)mapresult.get("MOBILE_NO"); if(sMobileNo == null) sMobileNo = "";
        sMobileCo		= (String)mapresult.get("MOBILE_CO");
        
        userTp			= request.getParameter("userTp");
        
        
     	// 비밀번호 찾기 session값 불러옴
		if (request.getParameter("type").equals("findPw")) {
			pwSearchId = (String) session.getAttribute("pwSearchId");

			System.out.println("pwSearchId == " + pwSearchId);
		}

		// java단 검증용
		session.setAttribute("niceIdResponseNumber", sResponseNumber);
		session.setAttribute("sName", sName);
		session.setAttribute("sBirthDate", sBirthDate);
		session.setAttribute("sGender", sGender);
		session.setAttribute("sMobileNo", sMobileNo);
		session.setAttribute("sDupInfo", sDupInfo);
		/* String session_sRequestNumber = (String)session.getAttribute("REQ_SEQ");
		if(!sRequestNumber.equals(session_sRequestNumber))
		{
		    sMessage = "세션값이 다릅니다. 올바른 경로로 접근하시기 바랍니다.";
		    sResponseNumber = "";
		    sAuthType = "";
		} */

		//[실명인증 후 가입정보 조회]               
		CDao dao = null;
		CBase cb = new CBase(request, response);

		// [휴대폰(M) 인증시]
		if (sAuthType.equals("M")) {
			String _hpNo = Cvt.String(sMobileNo);
			String hpNo2 = _hpNo.substring(3, 7);
			String hpNo3 = _hpNo.substring(7);
			String hpNo = "010-" + hpNo2 + "-" + hpNo3;

			//[1.이름 , 휴대전화번호로 조회]
			dao = new CDao("user.USER_VIEW", IDao.Select);
			dao.SetParameter("P_USER_NM", sName);
			dao.SetParameter("P_HP_NO", hpNo);
			Map<String, Object> rMap = dao.ExecuteMap();
			System.out.println("rMap = " + rMap);

			try {
				//[1-1 가입정보가 있을 경우]
				if (rMap != null && !rMap.isEmpty()) {
					// [1-1-1 아이디 값 가져오기]
					sUserId = (String) rMap.get("USER_ID");
				} else {
					//[1-2 가입정보가 없을 경우]
					sUserId = "";
				}
			} catch (Exception e) {
				e.printStackTrace();
			}

			// [공동인증서(X) 인증시]
		} /* else{
			//[1.중복가입 확인값(DI)으로 조회 ]
			dao = new CDao("user.MEMBER_JOIN_SELECT_DI", IDao.Select);
			dao.SetParameter("P_IPIN_KEY", sDupInfo);			
			Map<String,Object> rMap = dao.ExecuteMap();
			
			try {
					//[1-1 가입정보가 있을 경우]
					if(!MapUtils.isEmpty(rMap)){
						// [1-1-1 아이디 값 가져오기]
						sUserId = (String)rMap.get("userid");															
					}else{
					//[1-2 가입정보가 없을 경우]
						sUserId = "";
					}
			 	}catch(Exception e){
				  e.printStackTrace();
			}
			
			}	 */

		//회원가입(join) or 아이디/비밀번호 찾기(find)
		sType = cb.Get("type");
		System.out.println("1.type>>>>>>>>>>" + sType);
		System.out.println("2.sUserId>>>>>>>>>>" + sUserId);

	}

	else if (iReturn == -1) {
		sMessage = "복호화 시스템 에러입니다.";
	} else if (iReturn == -4) {
		sMessage = "복호화 처리오류입니다.";
	} else if (iReturn == -5) {
		sMessage = "복호화 해쉬 오류입니다.";
	} else if (iReturn == -6) {
		sMessage = "복호화 데이터 오류입니다.";
	} else if (iReturn == -9) {
		sMessage = "입력 데이터 오류입니다.";
	} else if (iReturn == -12) {
		sMessage = "사이트 패스워드 오류입니다.";
	} else {
		sMessage = "알수 없는 에러 입니다. iReturn : " + iReturn;
	}
%>
<%!

	public String requestReplace (String paramValue, String gubun) {

        String result = "";
        
        if (paramValue != null) {
        	
        	paramValue = paramValue.replaceAll("<", "&lt;").replaceAll(">", "&gt;");

        	paramValue = paramValue.replaceAll("\\*", "");
        	paramValue = paramValue.replaceAll("\\?", "");
        	paramValue = paramValue.replaceAll("\\[", "");
        	paramValue = paramValue.replaceAll("\\{", "");
        	paramValue = paramValue.replaceAll("\\(", "");
        	paramValue = paramValue.replaceAll("\\)", "");
        	paramValue = paramValue.replaceAll("\\^", "");
        	paramValue = paramValue.replaceAll("\\$", "");
        	paramValue = paramValue.replaceAll("'", "");
        	paramValue = paramValue.replaceAll("@", "");
        	paramValue = paramValue.replaceAll("%", "");
        	paramValue = paramValue.replaceAll(";", "");
        	paramValue = paramValue.replaceAll(":", "");
        	paramValue = paramValue.replaceAll("-", "");
        	paramValue = paramValue.replaceAll("#", "");
        	paramValue = paramValue.replaceAll("--", "");
        	paramValue = paramValue.replaceAll("-", "");
        	paramValue = paramValue.replaceAll(",", "");
        	
        	if(gubun != "encodeData"){
        		paramValue = paramValue.replaceAll("\\+", "");
        		paramValue = paramValue.replaceAll("/", "");
            paramValue = paramValue.replaceAll("=", "");
        	}
        	
        	result = paramValue;
            
        }
        return result;
  }
%>

<!-- 모바일 전용 -->
<form id="joinFrm" name="joinFrm" method="POST">
	<input type="hidden" id="userTp" name="userTp" />
</form>

<form id="idSearchFrm" name="idSearchFrm" method="POST">
	<input type="hidden" id="userId" name="userId" />
</form>



<script src="/common/front/kor/js/jquery-1.11.2.min.js"></script>
<script src="/common/admmgr/js/common.js"></script>
<script language='javascript'>
	var sUrl = sessionStorage.getItem("sUrl");
	
	var sMessage = '<%=sMessage%>';
	var name = '<%=sName%>';
	
	var type = '<%=sType%>';
	var userTp = '<%=userTp%>';
	var userId = '<%=sUserId%>';
	
	
	//회원가입일 경우
	if(type == 'join'){
		
		if(userId == ''){
			
			alert("본인인증이 완료되었습니다.");
			
			if( isMobile() ){
				fnCheckPlusResult('<%=sMessage%>', '<%=sName%>', '<%=sResponseNumber%>', '<%=sMobileNo%>', '<%=sDupInfo%>', '<%=sConnInfo%>', userTp, sUrl);
				//self.close();
			} else {
				opener.fnCheckPlusResult('<%=sMessage%>', '<%=sName%>', '<%=sResponseNumber%>', '<%=sMobileNo%>', '<%=sDupInfo%>', '<%=sConnInfo%>', userTp, sUrl);
				self.close();
			}
			
		}else{
			alert("이미 가입된 회원정보가 존재합니다. [아이디: " + userId + "]");
			
			if( isMobile() ){
				//$("#frm").attr("action", "/front/member/login.do").submit();
				location.href = "/front/member/login.do";
			} else {
				opener.$("#frm").attr("action", "/front/member/login.do").submit();
				self.close();
			}
			
		}
		
	//아이디/비밀번호 찾기 일 경우
	}else if(type == 'findId') {
		
		if(userId == ''){
			
			alert("가입된 정보가 없습니다.\n회원가입 후 이용해주세요.");
			
			if( isMobile() ){
				//$("#frm").attr("action", "/front/member/joinStep0.do").submit();
				location.href = "/front/member/joinStep0.do";
			} else {
				opener.$("#frm").attr("action", "/front/member/joinStep0.do").submit();
				self.close();
			}
			
		}else{
			//alert("귀하의 아이디 : [" + userId + "]");
			
			if( isMobile() ){
				fnCheckPlusResult2('<%=sMessage%>', '<%=sName%>', '<%=sResponseNumber%>', '<%=sMobileNo%>', '<%=sDupInfo%>', '<%=sConnInfo%>', userId, sUrl);
			} else {
				opener.fnCheckPlusResult('<%=sMessage%>', '<%=sName%>', '<%=sResponseNumber%>', '<%=sMobileNo%>', '<%=sDupInfo%>', '<%=sConnInfo%>', userId, sUrl);
				self.close();
			}
			
		}
		
	} else if(type == 'findPw') {
	
		var pwSearchId = '<%=pwSearchId%>';
		
		//alert("pwSearchId ===== " + pwSearchId);
		
		if(userId == ''){
			
			alert("가입된 정보가 없습니다.");
			
			if( isMobile() ){
				//$("#frm").attr("action", "/front/member/pwSearch.do").submit();
				location.href = "/front/member/pwSearch.do";
			} else {
				self.close();
			}
			
		} else {
			
			if( isMobile() ){
				//$("#frm").attr("action", "/front/member/pwdUpdate.do").submit();
				location.href = "/front/member/pwdUpdate.do";
				//self.close();
			} else {
				opener.$("#frm").attr("action", "/front/member/pwdUpdate.do").submit();
				self.close();
			}
			
		}
		
		
	}
	
	/* 회원가입 */
	function fnCheckPlusResult(sMessage, sName, sResponseNumber, sMobileNo , sDupInfo , sConnInfo, userTp, sUrl) {
		$("#userTp").val(userTp);
		$("#joinFrm").attr("action", "/front/member/joinStep3.do");
		$("#joinFrm").submit();
	}
	
	/* 아이디 찾기 */
	function fnCheckPlusResult2(sMessage, sName, sResponseNumber, sMobileNo , sDupInfo , sConnInfo, sUserId, sUrl) {
		$("#userId").val(sUserId);
		$("#idSearchFrm").attr("action", "/front/member/idSearchResult.do");
		$("#idSearchFrm").submit();
	}

</script>

