  <!-- ── 마이서비스 패널 로직 ── -->
  <script>
    (function () {
      var main = document.getElementById('main');
      var chatScroll = document.getElementById('chat-scroll');

      /*
       * 버튼 → 템플릿 매핑 패턴 (기존 kp-guide-panel__btn 흐름과 동일)
       * 버튼 클릭 → kp-main--chat 전환 → #chat-answer-body에 해당 템플릿 주입
       */
      function injectTemplate(tplId, pillText) {
        var turnTpl = document.getElementById('tpl-chat-turn');
        var localTpl = document.getElementById(tplId);
        if (!turnTpl || !localTpl || !chatScroll) return;

        var fragment = turnTpl.content.cloneNode(true);
        var thread = fragment.querySelector('[data-role="thread"]');
        var pill = fragment.querySelector('[data-role="query-pill"]');
        var body = fragment.querySelector('[data-role="answer-body"]');
        if (!thread || !pill || !body) return;

        pill.textContent = pillText;
        body.appendChild(localTpl.content.cloneNode(true));
        chatScroll.appendChild(fragment);

        if (window.PT_AI_AVATAR && typeof window.PT_AI_AVATAR.applyToThread === 'function') {
          window.PT_AI_AVATAR.applyToThread(thread);
        }
        main.classList.add('kp-main--chat');
        requestAnimationFrame(function () {
          chatScroll.scrollTop = chatScroll.scrollHeight;
        });
      }

      function runTemplateChat(tplId, pillText) {
        if (!document.getElementById(tplId)) return;
        if (window.PT_AI_CHAT && typeof window.PT_AI_CHAT.startChat === 'function') {
          window.PT_AI_CHAT.startChat(pillText, tplId);
          return;
        }
        injectTemplate(tplId, pillText);
      }

      /* chat 영역 이벤트 위임 — 템플릿 주입 후 동적으로 생성되는 버튼 처리 */
      document.getElementById('chat').addEventListener('click', function (e) {
        var t = e.target;

        /* 예약확인 — 방문예정 행 클릭 시 예약 변경 모달 열기 */
        var rsvRow = t.closest('.kp-rsv-row--upcoming');
        if (rsvRow) {
          var dtParts = (rsvRow.dataset.rsvDatetime || '').split(' ');
          document.getElementById('kp-rsv-modal-date').value   = dtParts[0] || '';
          document.getElementById('kp-rsv-modal-time').value   = dtParts[2] || '';
          document.getElementById('kp-rsv-modal-dept').value   = rsvRow.dataset.rsvDept || '';
          document.getElementById('kp-rsv-modal-doctor').value = rsvRow.dataset.rsvDoctor || '';
          document.getElementById('kp-rsv-modal').hidden = false;
        }

        /* 고객의 소리 — 게시판 행 클릭 시 답변 토글 (미답변 제외) */
        var boardHead = t.closest('.kp-board-item__head');
        if (boardHead && !boardHead.classList.contains('kp-board-item__head--pending')) {
          var expanded = boardHead.getAttribute('aria-expanded') === 'true';
          boardHead.setAttribute('aria-expanded', expanded ? 'false' : 'true');
          var body = boardHead.parentElement.querySelector('.kp-board-item__body');
          if (body) body.hidden = expanded;
        }

        /* 병문안 편지 — 수신/발신 탭 전환 */
        var letterTab = t.closest('.kp-letter-tab');
        if (letterTab) {
          var ltKey = letterTab.dataset.ltab;
          var letterWrap = letterTab.closest('.kp-answer-card__section');
          if (!letterWrap) return;
          letterWrap.querySelectorAll('.kp-letter-tab').forEach(function (btn) {
            btn.classList.toggle('is-active', btn.dataset.ltab === ltKey);
          });
          letterWrap.querySelectorAll('[data-lpanel]').forEach(function (panel) {
            panel.hidden = panel.dataset.lpanel !== ltKey;
          });
        }
      });

      /* 마이페이지 버튼 → include된 tpl-my-page 주입 */
      document.getElementById('btn-my-health').addEventListener('click', function (e) {
        e.preventDefault();
        e.stopPropagation();
        runTemplateChat('tpl-my-page', '마이페이지');
      });

      /* 회원정보 관리 버튼 → tpl-my-info 주입 */
      var btnMyInfo = document.getElementById('btn-my-info');
      if (btnMyInfo) {
        btnMyInfo.addEventListener('click', function (e) {
          e.preventDefault();
          e.stopPropagation();
          runTemplateChat('tpl-my-info', '회원정보 관리');
        });
      }

      /* 예약 변경 모달 닫기 */
      function closeRsvModal() {
        document.getElementById('kp-rsv-modal').hidden = true;
      }
      document.getElementById('btn-rsv-modal-close').addEventListener('click', closeRsvModal);
      document.querySelector('.kp-rsv-modal__backdrop').addEventListener('click', closeRsvModal);
    }());
  </script>

