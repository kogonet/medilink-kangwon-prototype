    /* 아바타 SVG (이미지 없을 때 fallback) */
    var AVATAR_SVG = '<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 3.6-7 8-7s8 3 8 7"/></svg>';
    var IMG_BASE = '${ptAiWebPath}/common/images/doctor/';

    /* 모달 열기 */
    function openModal() {
      modal.hidden = false;
      document.body.style.overflow = 'hidden';
    }

    var searchInput = document.getElementById('dept_search_input');
    var noResult    = modal.querySelector('.dept_no_result');
    var sidebar     = document.getElementById('dept_sidebar');

    /* 모달 닫기 */
    function closeModal() {
      modal.hidden = true;
      document.body.style.overflow = '';
      modal.querySelectorAll('.dept_list_item').forEach(function (i) { i.classList.remove('is-active'); });
      if (searchInput) { searchInput.value = ''; filterList(''); }
      renderPlaceholder();
    }

    /* 플레이스홀더 */
    function renderPlaceholder() {
      staffArea.innerHTML =
        '<div class="kp-doctor-modal__staff-ph">' +
          '<span class="kp-doctor-modal__staff-ph-ico" aria-hidden="true">' +
            '<img src="${ptAiWebPath}/common/images/doctor.svg" alt="">' +
          '</span>' +
          '<p>진료과·전문센터·클리닉을 선택하시면<br>의료진 소개를 확인할 수 있습니다.</p>' +
        '</div>';
    }

    /* 의료진 카드 렌더 */
    function renderDoctors(deptName) {
      var list = DOCTOR_DATA[deptName];
      var html = '<p class="kp-doctor-modal__staff-head">' + deptName + '</p>';

      if (!list || list.length === 0) {
        html += '<div class="kp-doctor-modal__staff-pending">' +
          '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 8v4M12 16h.01"/></svg>' +
          '의료진 정보를 준비 중입니다.' +
        '</div>';
      } else {
        html += '<div class="kp-doctor-cards">';
        list.forEach(function (doc) {
          var tagHtml = doc.tags.map(function (t) {
            return '<span class="kp-doctor-card__tag">' + t + '</span>';
          }).join('');
          /* 이미지 로드 실패 시 SVG 아바타로 fallback */
          var photoSrc = IMG_BASE + (doc.photo || (deptName + '-' + doc.name + '.jpg'));
          var avatarBlock =
            '<img class="kp-doctor-card__photo" src="' + photoSrc + '" alt="' + doc.name + '" ' +
              'onerror="this.style.display=\'none\';this.nextElementSibling.style.display=\'flex\'">' +
            '<div class="kp-doctor-card__avatar" aria-hidden="true" style="display:none">' + AVATAR_SVG + '</div>';
          html +=
            '<div class="kp-doctor-card" data-doctor-query="' + doc.name + ' 선생님 소개">' +
              avatarBlock +
              '<p class="kp-doctor-card__name">' + doc.name + '</p>' +
              '<p class="kp-doctor-card__position">' + doc.position + '</p>' +
              '<div class="kp-doctor-card__tags">' + tagHtml + '</div>' +
            '</div>';
        });
        html += '</div>';
      }
      staffArea.innerHTML = html;
    }

    /* 사이드바 검색 필터 */
    function filterList(query) {
      var q = query.replace(/\s/g, '').toLowerCase();
      var activeList = sidebar.querySelector('.dept_list:not([hidden])');
      if (!activeList) return;
      var items = activeList.querySelectorAll('.dept_list_item');
      var hasVisible = false;
      items.forEach(function (item) {
        var text = item.textContent.replace(/\s/g, '').toLowerCase();
        var visible = !q || text.indexOf(q) !== -1;
        item.style.display = visible ? '' : 'none';
        if (visible) hasVisible = true;
      });
      if (noResult) noResult.hidden = hasVisible;
    }

    /* 탭 전환 */
    modal.querySelectorAll('.kp-doctor-modal__tab').forEach(function (tab) {
      tab.addEventListener('click', function () {
        var key = tab.dataset.dtab;
        modal.querySelectorAll('.kp-doctor-modal__tab').forEach(function (t) {
          t.classList.toggle('is-active', t.dataset.dtab === key);
          t.setAttribute('aria-selected', t.dataset.dtab === key ? 'true' : 'false');
        });
        /* 사이드바 내 list 패널 전환 */
        sidebar.querySelectorAll('.dept_list[data-dpanel]').forEach(function (p) {
          p.hidden = p.dataset.dpanel !== key;
        });
        /* 탭 변경 시 초기화 */
        modal.querySelectorAll('.dept_list_item').forEach(function (i) { i.classList.remove('is-active'); });
        if (searchInput) { searchInput.value = ''; filterList(''); }
        renderPlaceholder();
      });
    });

    /* 사이드바 항목 클릭 → 의료진 표시 */
    sidebar.addEventListener('click', function (e) {
      var item = e.target.closest('.dept_list_item');
      if (!item) return;
      modal.querySelectorAll('.dept_list_item').forEach(function (i) { i.classList.remove('is-active'); });
      item.classList.add('is-active');
      renderDoctors(item.dataset.dept);
      staffArea.scrollTop = 0;
    });

    staffArea.addEventListener('click', function (e) {
      var card = e.target.closest('.kp-doctor-card');
      if (!card) return;
      var query = card.dataset.doctorQuery;
      if (!query) return;
      closeModal();
      if (window.PT_AI_CHAT && typeof window.PT_AI_CHAT.startChat === 'function') {
        window.PT_AI_CHAT.startChat(query);
      }
    });

    /* 검색 인풋 */
    if (searchInput) {
      searchInput.addEventListener('input', function () {
        filterList(searchInput.value);
      });
    }

    /* 닫기 */
    btnClose.addEventListener('click', closeModal);
    backdrop.addEventListener('click', closeModal);
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && !modal.hidden) closeModal();
    });

    /* 의료진 소개 카드의 버튼 클릭 → 모달 열기 */
    document.addEventListener('click', function (e) {
      var btn = e.target.closest('.kp-guide-panel__btn--go');
      if (btn) {
        e.preventDefault();
        openModal();
      }
    });
  }());
  </script>
