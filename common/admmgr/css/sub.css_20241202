.ico_custom18{ background-image: url('/common/admmgr/images/icon/ico_menu18.svg') !important; }
.ico_custom19{ background-image: url('/common/admmgr/images/icon/ico_menu19.svg') !important; }
.ico_custom20{ background-image: url('/common/admmgr/images/icon/ico_menu20.svg') !important; }
.ico_custom21{ background-image: url('/common/admmgr/images/icon/ico_menu21.svg') !important; }
.ico_custom22{ background-image: url('/common/admmgr/images/icon/ico_menu22.svg') !important; }
