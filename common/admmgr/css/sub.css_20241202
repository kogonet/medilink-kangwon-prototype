.ico_custom09{ background-image: url('/common/admmgr/images/icon/ico_menu09.svg') !important; }
.ico_custom10{ background-image: url('/common/admmgr/images/icon/ico_menu10.svg') !important; }
.ico_custom11{ background-image: url('/common/admmgr/images/icon/ico_menu11.svg') !important; }
.ico_custom12{ background-image: url('/common/admmgr/images/icon/ico_menu12.svg') !important; }
.ico_custom13{ background-image: url('/common/admmgr/images/icon/ico_menu13.svg') !important; }
.ico_custom14{ background-image: url('/common/admmgr/images/icon/ico_menu14.svg') !important; }
