.ico_default{ background-image: url('/common/admmgr/images/layout_n/ico_dep02.png') !important;}


/* 등록게시물 no */
.con_empty { position:relative; display:block; width:100%; padding:15px 0; } 
.con_empty .empty_txt { display:inline-block; zoom:1; *display:inline; margin:0 auto; padding-top:40px; background: url(/common/admmgr/images/sub_common/ico_empty01.svg) no-repeat center 0; color:#666; letter-spacing:-0.75px; } 
[data-theme='dark'] .con_empty .empty_txt { color:#fff; } 
.td_empty { position:relative; display:block; width:100%; padding:15px 0; } 
.td_empty .td_txt { display:inline-block; zoom:1; *display:inline; margin:0 auto; padding-top:60px; background:url(../images/sub_common/bg_file01.png) no-repeat center 0; font-size:14px; font-weight:400; line-height:22px; color:#666; letter-spacing:-0.75px; } 


/* board list down */
.btn_down_wrap { position: relative; } 
.btn_down_wrap .btn_down {color: transparent;font-size: 0px;background: url(/common/admmgr/images/icon/ico_down01_g.svg)no-repeat center center;width: 20px;height: 20px;display: table;margin: 0 auto;border: 1px solid #e2e2e2;box-sizing: border-box;} 
.btn_down_wrap.act .btn_down { background: url(/common/admmgr/images/icon/ico_down01_b.svg)no-repeat center; border-color:#0a4a9b; } 

.btn_down_wrap .down_pop_wrap { display: none; } 
.btn_down_wrap.act .down_pop_wrap { display:block; position:absolute; top: 0; width: 320px; left: 50%; transform: translateX(-50%); margin-left: -185px; z-index: 1; } 

.down_pop_top { background-color: #0d79de; display: flex; justify-content: space-between; height: 40px; align-items: center; padding: 5px 15px; box-sizing: border-box; } 
.down_pop_top > p { font-size: 15px; font-weight: 500; color: #fff; letter-spacing: -0.25px; line-height: 1; } 
.down_pop_bott { border: 1px solid #0d79de; background-color: #fff; box-sizing: border-box; padding: 10px 15px; } 
.down_pop_list > li { margin-top: 10px; text-align:left; } 
.down_pop_list > li:first-of-type { margin-top:0; } 
.down_pop_list > li > a { position: relative; font-size: 13px; font-weight: 300; color: #666666; letter-spacing: -0.25px; line-height: 1.35; text-align: left; display: block; padding-left: 25px; padding-right: 15px; box-sizing: border-box; cursor:pointer; } 
.down_pop_list > li > a { color:#666; } 
[data-theme='dark'] .down_pop_list > li > a { color:#666; } 
.down_pop_list > li > a:before { position: absolute; content: ''; display: block; left:0; width: 17px; height: 17px; top: 1px; } 
.down_pop_list > li > a:after { position:absolute; content:''; display:block; right:0; top: 3px; background-image: url(/common/admmgr/images/icon/ico_down01_g.svg); background-repeat:no-repeat; background-position: center center; width: 10px; height: 11px; } 
.down_pop_list > li:hover > a:after { background-image: url(/common/admmgr/images/icon/ico_down01_s.svg); } 

.down_pop_list > li.down_hwp > a:before { background-image: url(/common/admmgr/images/icon/ico_hwp02.svg); } 
.down_pop_list > li.down_pdf > a:before { background-image: url(/common/admmgr/images/icon/ico_pdf02.svg); } 
.down_pop_list > li.down_zip > a:before { background-image: url(/common/admmgr/images/icon/ico_zip02.svg); } 
.down_pop_list > li.down_etc > a:before { background-image: url(/common/admmgr/images/icon/ico_file.svg); } 
.down_pop_list > li.ico_etc > a:before { background-image: url(/common/admmgr/images/icon/ico_file.svg); } 
.down_pop_list > li.down_ppt > a:before { background-image: url(/common/admmgr/images/icon/ico_ppt02.svg); } 
.down_pop_list > li.down_excel > a:before { background-image: url(/common/admmgr/images/icon/ico_xlsx02.svg); } 
.down_pop_list > li.down_word > a:before { background-image: url(/common/admmgr/images/icon/ico_doc02.svg); } 
.down_pop_list > li.down_png > a:before { background-image: url(/common/admmgr/images/icon/ico_png02.svg); } 
.down_pop_list > li.down_jpg > a:before { background-image: url(/common/admmgr/images/icon/ico_jpg02.svg); } 


.popup_wrap { display: block; position: fixed; top: 0; left: 0; width: 100%; height: 100%; z-index: 10000; } 
.popup_wrap .popup_dim { display: block; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0, 0, 0, 0.45); z-index:9999; } 
.popup_wrap .popup_inner { display: block; position: relative; top: 50%; left: 50%; width: 80%; max-width: 520px; background: #fff; z-index:10000; transform: translate(-50%, -50%); box-shadow: 10px 0 25px rgb(0 0 0 / 25%); } 
.popup_wrap .popup_inner:before { position:absolute; top: -64px; left: 50%; margin-left: -63px; display: block; width:126px; height:126px; border-radius:126px; background: url(/common/admmgr/images/sub/ico_circle_notice.png) no-repeat 0 0; content:""; } 
.popup_wrap .popup_header { position:relative; padding:15px; } 
.popup_wrap .popup_content { padding: 45px; } 
.popup_wrap .popup_content .con_txt { font-size:20px; font-weight:400; color:#222; line-height:1.6; letter-spacing:-0.75px; text-align:center; } 
.popup_wrap .popup_content .con_txt strong { font-weight:600; } 
.popup_wrap .btn_area { display: flex; width:100%; position:relative; bottom:0; left:0; padding:0; box-sizing:border-box; text-align:center; margin: 0; align-items: center; } 
.popup_wrap .btn_area a { display:inline-flex; height: 50px; flex: 1 0; vertical-align:middle; background:#0F4C80; text-align:center; font-size:15px; font-weight:700; color:#fff; align-items: center; justify-content: center; } 
.popup_wrap .btn_area a.btn_pop_sty1 { background:#dddddd; color:#222; } 


.icon_menu_list { display:flex; gap:8px; align-items:center; text-align:center; flex-wrap:wrap; } 
.icon_menu_list li { flex: 0 0 45px; background: #f1f5ff; border: 1px solid #d9dcde; border-radius:2px; padding:8px; } 
.icon_menu_list .icon { display:flex; width:32px; height:32px; border-radius:2px; box-sizing:brder-box; } 
.icon_menu_list .icon img {/* filter:invert(70%); */} 
[data-theme='dark'] .icon_menu_list li { background: #414648; border-color: #414648; } 
[data-theme='dark'] .icon_menu_list .icon img { filter:invert(0%); } 
.icon_menu_list label.ch { margin:0; } 

/* 사이트맵 */
.sitemap_wrap.is-open { display: block; } 
.sitemap_wrap { /* display: none; */position: fixed; z-index: 100; } 
.sitemap_wrap:before { position: fixed; content:''; display:block; background: rgba(0,0,0,.6); width: 100%; height: 100%; left: 50%; top: 50%; transform: translate(-50%, -50%); z-index: -1; } 
.sitemap_inner { background-color: #f1f5ff; width: 1200px; height: 700px; max-width:80%; max-height:80%; position: fixed; left: 50%; top: 50%; transform: translate(-50%, -50%); padding: 30px 40px; box-sizing: border-box; } 
.sitemap_tit { display:flex; align-items:center; justify-content:space-between; font-size:15px; font-weight:500; color:#000; margin-bottom:10px; line-height:1; } 
.sitemap_close { position: relative; display:block; width: 16px; height: 16px; background: transparent; cursor: pointer; border: 1px solid #444; } 
.sitemap_close:before, 
.sitemap_close:after { content: ""; position: absolute; width: 1px; height: 100%; background-color: #444444; top: 0; left: 50%; transform: translateX(-50%) rotate(45deg); } 
.sitemap_close:after { transform: translateX(-50%) rotate(-45deg) } 

.sitemap_con { height: calc(100% - 30px); overflow-y: auto; padding-right:10px; } 
.sitemap_menu { display:flex; gap:10px; flex-wrap: wrap; } 
.sitemap_menu > li { flex: 1 0 120px; } 
.sitemap_menu > li > a { display:flex; height:40px; align-items:center; font-size: 13px; font-weight:500; color: #2665ba; background: #f0f4f8; border: 1px solid #c4d1de; justify-content: center; } 
.sitemap_menu .sec_ul { background: #fff; border: 1px solid #c4d1de; border-top: 0; padding: 12px; max-height: 157px; overflow-y: auto; } 
.sitemap_menu .sec_ul > li > a { position:relative; display:block; padding-left: 12px; font-size:12px; font-weight:500; color:#414648; line-height: 22px; } 
.sitemap_menu .sec_ul > li > a:hover { color:#2665ba; text-decoration:underline; } 
.sitemap_menu .sec_ul > li > a:before { position:absolute; top: 8px; left:0; content:""; display:block; width:3px; height:3px; border-radius:3px; background: #2665ba; } 

/* 툴팁 */
.tooltip {position: relative;display: inline-flex;vertical-align: -3px;} 
.tooltip_icon { position:relative; display: inline-block; width: 16px; height: 16px; border-radius: 16px; border: 0; vertical-align: -4px; background: url(/common/admmgr/images/icon/ico_tooltip_b.svg) no-repeat 0 0; } 
.tooltip_inner { display: none; position:absolute; top: 29px; left: -12px; max-width: 500px; min-width: 300px; border-radius:2px; border:1px solid #d6dae1; background:#fff; font-size:12px; line-height: 20px; font-weight:400; color:#000; z-index: 1; } 
.tooltip_con { position:relative; padding: 16px 24px 16px 16px; overflow:hidden; } 
.tooltip_close { position: absolute; top: 8px; right: 8px; display:block; width: 12px; height: 12px; background: transparent; cursor: pointer; border: 0; } 
.tooltip_close:before, 
.tooltip_close:after { content: ""; position: absolute; width: 1px; height: 100%; background-color: #444444; top: 0; left: 50%; transform: translateX(-50%) rotate(45deg); } 
.tooltip_close:after { transform: translateX(-50%) rotate(-45deg) } 
.tooltip_arrow { position:absolute; top: -8px; left: 12px; display:block; width:9px; } 
.tooltip_arrow:before { content:""; } 
.tooltip_arrow:after { content:""; background:#fff; border-color:#ddd; border-width:1px 0 0 1px; border-style:solid; height:12px; width: 12px; display:inline-block; transform:rotate(45deg); } 

/* 상단 타이틀 박스*/
.box_tit{display: flex;background: #6D7993;height: 36px;padding: 0 20px;align-items: center; justify-content: space-between;}
.box_tit .title{position:relative;display: inline-flex;padding-left:13px;font-size: 13px;font-weight: 300;color: #fff;line-height: 1;letter-spacing:-0.5px;} 
.box_tit .title:before {display:block;position:absolute;top: 4px;left:0;width:5px;height:5px;background: #fffbfb;border-radius:5px;content:"";} 

/* 에러페이지 */
.errorWrap {position:relative; width:100%; height:500px; margin:0; padding:0; text-align:center;}
.errorWrap .error {position:absolute;left:50%;top:50%;width:660px;height: auto;transform: translate(-50%, -50%);}
.errorWrap .error img{height:60px;}
.errorWrap .error p.txt {font-size: 14px;letter-spacing: -1px;color:#888;padding: 8px 0 0 0;}
.errorWrap .error p.title{font-size:20px; color:#000; }
.errorWrap .error .btnGroup {margin:0;/* padding:45px 0 0 0; */text-align:center;}
.errorWrap .error .btnGroup .btn {display: inline-block;padding: 9px 20px;line-height: 1.1em;font-size: 1.0em;font-family: fontNg;color: #fff;border: 0;background: #888;text-decoration: none;}
.errorWrap .error .btnGroup .btn.btnPost {background: #1c7ce6;}